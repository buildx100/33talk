# 33talk -- local inference only. There is no API key anywhere:
# no key means no secret to hide, which is why there is no backend code.

# Where the browser reaches the machine.
PORT=16001

# The model, baked into the image at build time. ggml-org is llama.cpp's
# own HuggingFace org, so the GGUF and the server binary come from the same
# people. Q4_0 of qwen3:0.6b is 429 MB.
MODEL_REPO=ggml-org/Qwen3-0.6B-GGUF
MODEL_FILE=Qwen3-0.6B-Q4_0.gguf

# Use a mirror where huggingface.co is unreachable:
#   HF_HOST=https://hf-mirror.com
HF_HOST=https://huggingface.co
